{
  "name": "finaldiagrams",
  "version": "0.4.1",
  "description": "Editable offline technical documents and evidence-backed monorepo onboarding guides",
  "type": "module",
  "private": true,
  "bin": { "finaldiagrams": "./bin/finaldiagrams.mjs" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test test/core.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:state": "node test/state-browser.mjs",
    "test:database": "node test/database-browser.mjs",
    "test:canvas": "node test/canvas-editing.mjs",
    "test:editor": "node test/editor-improvements.mjs",
    "test:diagram-editing": "node test/diagram-editing.mjs",
    "test:performance": "node test/editor-performance.mjs",
    "test:bounds": "node test/canvas-bounds.mjs",
    "test:groups": "node test/group-editing.mjs",
    "test:group-routing": "node test/group-routing.mjs",
    "test:deletion": "node test/selection-deletion.mjs",
    "test:blocks": "node test/block-reordering.mjs",
    "test:context": "node test/context-editing.mjs",
    "test:info": "node test/info-card.mjs",
    "test:connected": "node --test test/connected.test.mjs",
    "test:release": "node --test test/release.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dompurify": "3.4.16",
    "elkjs": "0.9.3",
    "marked": "16.4.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.57.0"
  }
}
